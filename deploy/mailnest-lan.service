[Unit]
Description=MailNest LAN preview
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/volume2/workspace/mailnest

[Service]
Type=simple
WorkingDirectory=/volume2/workspace/mailnest
ExecStart=/root/.nvm/versions/node/v24.21.0/bin/node /volume2/workspace/mailnest/server/dist/index.js
Environment=NODE_ENV=development
Environment=HOST=0.0.0.0
Environment=PORT=5173
Environment=APP_URL=http://192.168.91.85:5173
Environment=GOOGLE_REDIRECT_URI=http://192.168.91.85:5173/api/v1/oauth/google/callback
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/volume2/workspace/mailnest/data
UMask=0077

[Install]
WantedBy=multi-user.target
