# 先 npm install，再 npm run init 自动生成随机密码和密钥。
# 该文件只说明字段，不能直接以占位秘密启动。
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_URL=http://localhost:5173
# 相对路径以项目根目录为基准，与执行命令所在目录无关。
DATA_DIR=./data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NAME=管理员
# 必须为随机 32 字节（64 位十六进制）；现有数据恢复必须沿用原值。
ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/oauth/google/callback
SYNC_INTERVAL_SECONDS=60
# 每个邮箱每个可选文件夹最近同步的摘要数量（20–1000）；另外同步窗口外星标。
SYNC_MESSAGE_LIMIT=200
# 每位使用者全部账号/目录合并后的最新正文预缓存数量（0–1000）；星标另行预缓存。
MAIL_CACHE_RECENT_COUNT=100
# 全实例正文/附件元数据缓存上限（MiB，4–1024）；优先星标和最新邮件，不含列表摘要。
# 原始 MIME 和附件二进制不落盘；容量不足时，未缓存的正文仍可按需读取。
MAIL_CACHE_MAX_MIB=256
# 非星标且不在最新范围内的正文，最后访问后的有效期（天，1–365）。
MAIL_CACHE_TTL_DAYS=7
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
TRUST_PROXY=false
ALLOW_PRIVATE_MAIL_HOSTS=false
# 仅 deploy/compose.public.yml 使用；不含 https://。
DOMAIN=
